#!/usr/bin/env bash
# Execute a Jupyter notebook via papermill, inside this project's environment.
#
# Usage: runnotebook input.ipynb output.ipynb [papermill options]
#   Example: runnotebook notebooks/analysis.ipynb out.ipynb -p param1 value1
#
# Sources env/env.sh rather than restating the bridge. It previously carried its
# own copy that was missing JULIA_LOAD_PATH, which runpython did set -- so a
# notebook resolved Julia packages differently from a script running the same
# analysis, and nothing announced it.
set -euo pipefail

# Executed, not sourced, so `unset` is right here. See env/env.sh for why the
# sourced side must use `CDPATH= cd --` instead.
unset CDPATH

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/../env.sh"

if [[ -z "${REPRO_PYTHON:-}" || ! -x "$REPRO_PYTHON" ]]; then
    echo "❌ Python environment not found. Run: make environment" >&2
    exit 1
fi

PAPERMILL="$REPRO_VENV/bin/papermill"
if [[ ! -x "$PAPERMILL" ]]; then
    echo "❌ papermill not found at: '$PAPERMILL'" >&2
    echo "   Run: make environment" >&2
    exit 1
fi

exec "$PAPERMILL" "$@"
