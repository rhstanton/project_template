#!/usr/bin/env bash
# Run Python inside this project's environment.
#
# Carries no environment of its own. Everything comes from env/env.sh, which
# sources the shared toolchain from the repro-tools submodule. This script used
# to restate the Julia bridge itself, and so did runjulia, runstata and
# runnotebook -- four copies that had drifted apart, with runnotebook missing
# JULIA_LOAD_PATH entirely and runjulia setting a differently-named variable to a
# different value. One copy, or they diverge again.
set -euo pipefail

# This script is EXECUTED, so `unset` is correct. In env/env.sh, which is
# *sourced*, the same hazard must be handled with `CDPATH= cd --` inside the
# command substitution instead, so it does not mutate the caller's shell.
unset CDPATH

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/../env.sh"

# env.sh deliberately does not fail on a missing environment -- a fresh clone
# should still get a usable interactive shell. This is the layer that must fail
# loudly, because something is about to run.
if [[ -z "${REPRO_PYTHON:-}" || ! -x "$REPRO_PYTHON" ]]; then
    echo "❌ Python env not found at: '${REPRO_PROJECT_ROOT:-?}/.venv/bin/python'"
    echo "   Run: make environment"
    exit 1
fi

exec "$REPRO_PYTHON" -u "$@"
