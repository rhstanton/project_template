#!/usr/bin/env bash
# ==============================================================================
# Stata Environment Runner
# ==============================================================================
#
# Usage:
#   env/scripts/runstata script.do [args...]
#
# Sources env/env.sh so the project root and DATA_DIR are resolved the same way
# as everywhere else, rather than by a local `cd`.
# ==============================================================================

# pipefail is deliberately ON, unlike the previous version. Without it, the
# `| tee` below made $? report tee's status -- effectively always 0 -- so a Stata
# crash or a timeout kill looked like success. The grep for execute.ado's error
# marker caught do-file errors and hid how narrow that safety net was.
set -euo pipefail

# Executed, not sourced, so `unset` is correct here.
unset CDPATH

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/../env.sh"

# Checked before use: with `set -u`, a bare $1 would abort with an unbound
# variable error instead of showing the usage line.
if [[ $# -lt 1 || -z "${1:-}" ]]; then
    echo "Usage: runstata <file.do>" >&2
    exit 1
fi
DO_FILE="$1"

if ! command -v stata-mp >/dev/null 2>&1; then
    echo "❌ stata-mp not found on PATH." >&2
    echo "   Stata is optional in this template; install it, or run the" >&2
    echo "   Python or Julia paths instead." >&2
    exit 127
fi

# Resolve the do-file BEFORE changing directory, so a path relative to wherever
# the caller stood keeps working. Without this, `runstata examples/foo.do` run
# from env/ cd'd to the repo root and then asked Stata for examples/foo.do
# THERE, which fails with r(601) -- a file-not-found reported as though the
# do-file itself were broken. Found 2026-08-18 while porting these fixes to
# fire, which had the same bug and could not even report it.
if [[ -f "$DO_FILE" ]]; then
    DO_FILE="$(cd -- "$(dirname -- "$DO_FILE")" && pwd)/$(basename -- "$DO_FILE")"
fi

cd -- "$REPRO_PROJECT_ROOT"

TEMP_DO=$(mktemp "${TMPDIR:-/tmp}/stata_XXXXXX.do")
TEMP_OUT=$(mktemp "${TMPDIR:-/tmp}/stata_out_XXXXXX.txt")
trap 'rm -f "$TEMP_DO" "$TEMP_OUT"' EXIT

{
    echo "quietly adopath ++ \"${REPRO_PROJECT_ROOT}/.stata/ado/plus\""
    echo "quietly adopath ++ \"${REPRO_PROJECT_ROOT}/env/scripts\""
    echo "execute ${DO_FILE}"
} > "$TEMP_DO"

# - timeout (default 10s, override with STATA_TIMEOUT) kills hung runs
# - -q suppresses the banner; TERM=dumb stops Stata waiting on the terminal
# - </dev/null ensures it cannot wait on stdin
#
# Stata batch mode returns 0 even when a do-file fails, so the grep below is
# still required; execute.ado prints the marker it looks for. PIPESTATUS gives
# the real status of the timeout/stata side of the pipe.
echo ""
set +e
TERM=dumb timeout "${STATA_TIMEOUT:-10}" stata-mp -q do "$TEMP_DO" </dev/null 2>&1 | tee "$TEMP_OUT"
STATA_EXIT=${PIPESTATUS[0]}
set -e

if [[ "$STATA_EXIT" -eq 124 ]]; then
    echo "Stata timed out after ${STATA_TIMEOUT:-10}s" >&2
    exit 124
fi

if grep -q "Error in do-file (return code:" "$TEMP_OUT"; then
    ERROR_CODE=$(grep "Error in do-file (return code:" "$TEMP_OUT" \
        | sed 's/.*return code: \([0-9]\+\).*/\1/' | tail -1)
    echo "Stata script failed with return code $ERROR_CODE" >&2
    exit 1
fi

echo ""
exit "$STATA_EXIT"
