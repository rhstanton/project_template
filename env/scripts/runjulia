#!/usr/bin/env bash
# ==============================================================================
# Julia Environment Runner
# ==============================================================================
#
# Usage:
#   env/scripts/runjulia script.jl [args...]
#
# Sources env/env.sh for the environment rather than declaring its own. The
# block it used to carry disagreed with runpython's in two ways that mattered:
# it set JULIAPKG_PROJECT (a name juliapkg does not read; the real one is
# PYTHON_JULIAPKG_PROJECT) to env/ where runpython set .julia, and it defaulted
# JULIA_NUM_THREADS to 1 while the Makefile exported $(nproc). Thread count
# changes floating-point reduction order, so those two entry points could return
# different last digits for the same regression.
#
# What stays here is genuinely Julia-specific: locating the bundled binary,
# the version check, and stripping OSC title escapes from the output.
# ==============================================================================

set -euo pipefail

# Executed, not sourced, so `unset` is correct. env/env.sh must instead use
# `CDPATH= cd --` inside its command substitution.
unset CDPATH

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/../env.sh"

# Matches juliacall's own floor (^1.10.3), not the newest Julia that happens to
# be installed here. It was 1.12.0, which made the warning fire on every platform
# where OpenSSL_jll caps Julia below that -- including GitHub runners, where 1.11.9
# is the most that can be installed. A warning that fires on correct, expected
# configurations trains people to ignore it.
REQUIRED_VERSION_MIN="${REQUIRED_VERSION_MIN:-1.10.3}"

# Use the bundled Julia installed by `make environment`. Never fall back to a
# global juliaup Julia -- the project must use its own repo-local copy. env.sh
# has already stripped juliaup from PATH; an explicit JULIA_BIN override is still
# honored for debugging.
BUNDLED_JULIA="$REPRO_PROJECT_ROOT/.julia/pyjuliapkg/install/bin/julia"
if [[ -x "$BUNDLED_JULIA" ]]; then
    JULIA_BIN="${JULIA_BIN:-$BUNDLED_JULIA}"
fi

PROJECT_ABS="$JULIA_PROJECT"

if [[ -z "${JULIA_BIN:-}" ]] || ! command -v "$JULIA_BIN" >/dev/null 2>&1; then
    echo "❌ Bundled Julia not found. Run: make environment   (or set JULIA_BIN)." >&2
    exit 127
fi

if [[ ! -f "$PROJECT_ABS/Project.toml" ]]; then
    echo "❌ Missing Project.toml at: $PROJECT_ABS" >&2
    echo "   Run: make environment" >&2
    exit 1
fi

# --- version check inside Julia (warn only; never block) ---
VER_OK="$("$JULIA_BIN" --startup-file=no -e \
  "try
     using Pkg
     v=parse(VersionNumber, string(VERSION))
     need=parse(VersionNumber, ARGS[1])
     print(v >= need ? \"ok\" : \"old\")
   catch e
     # If something odd happens, don't block execution.
     print(\"ok\")
   end" "$REQUIRED_VERSION_MIN")"

if [[ "$VER_OK" != "ok" ]]; then
    FOUND_VERSION="$("$JULIA_BIN" --startup-file=no -e 'print(VERSION)')"
    echo "⚠️  Julia $FOUND_VERSION found, but >= $REQUIRED_VERSION_MIN is recommended." >&2
fi

# Stop shells/themes from pushing OSC titles (harmless if not present)
unset PROMPT_COMMAND 2>/dev/null || true
export DISABLE_AUTO_TITLE=true
export JULIA_NO_TTY_TITLE=1
export TERM="${TERM:-dumb}"

# Run Julia, strip OSC "set title" sequences, preserve Julia's exit code.
# (OSC 0 pattern: ESC ] 0 ; ... BEL)
echo ""
"$JULIA_BIN" --startup-file=no --project="$PROJECT_ABS" "$@" 2>&1 \
  | perl -pe 's/\e\]0;.*?\a//g'
exit "${PIPESTATUS[0]}"
